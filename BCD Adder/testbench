`timescale 1ns/1ps

module bcd_adder_tb;

reg  [3:0] a;
reg  [3:0] b;
wire [3:0] sum;
wire       carry;

bcd_adder uut (
    .a(a),
    .b(b),
    .sum(sum),
    .carry(carry)
);

initial begin

    $display("========================================");
    $display("          BCD ADDER TESTBENCH");
    $display("========================================");
    $display(" A   B   | Carry   Sum");
    $display("------------------------");

    a = 4'd3; b = 4'd4;
    #10;
    $display(" %d   %d   |   %d       %d", a, b, carry, sum);

    a = 4'd5; b = 4'd4;
    #10;
    $display(" %d   %d   |   %d       %d", a, b, carry, sum);

    a = 4'd7; b = 4'd5;
    #10;
    $display(" %d   %d   |   %d       %d", a, b, carry, sum);

    a = 4'd8; b = 4'd7;
    #10;
    $display(" %d   %d   |   %d       %d", a, b, carry, sum);

    a = 4'd9; b = 4'd9;
    #10;
    $display(" %d   %d   |   %d       %d", a, b, carry, sum);

    $display("========================================");

    $finish;
